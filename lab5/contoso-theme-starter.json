{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.153.json",
  "name": "Contoso starter",
  "dataColors": [
    "#B3B0AD",
    "#252423",
    "#1F5AA6"
  ],
  "foreground": "#252423",
  "background": "#FFFFFF",
  "bad": "#B42318",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": false
          }
        ],
        "legend": [
          {
            "show": false
          }
        ]
      }
    }
  }
}
